rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
    
    function isSignedIn() { return request.auth != null; }
    function isOwner(userId) { return isSignedIn() && request.auth.uid == userId; }
    function existing() { return resource.data; }
    function incoming() { return request.resource.data; }
    function isValidId(id) { return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); }

    function isValidUser(data) {
      return data.keys().hasAll(['email', 'name', 'createdAt']) &&
             data.keys().size() == 3 &&
             data.email is string && data.email.size() <= 256 &&
             data.name is string && data.name.size() <= 256 &&
             data.createdAt == request.time;
    }

    function isValidChat(data, mode) {
      let isCreate = mode == 'create';
      let hasKeys = isCreate ? data.keys().hasAll(['title', 'messages', 'createdAt', 'updatedAt']) && data.keys().size() == 4 : true;
      return hasKeys &&
             data.title is string && data.title.size() <= 256 &&
             data.messages is list && data.messages.size() <= 500 &&
             (data.messages.size() == 0 || data.messages[0] is map) &&
             (isCreate ? data.createdAt == request.time : incoming().createdAt == existing().createdAt) &&
             data.updatedAt == request.time;
    }

    match /users/{userId} {
      allow read: if isOwner(userId);
      allow create: if isOwner(userId) && isValidId(userId) && isValidUser(incoming());
      allow update: if isOwner(userId) && isValidId(userId) &&
                    incoming().diff(existing()).affectedKeys().hasOnly(['name']) &&
                    incoming().name is string && incoming().name.size() <= 256;
      allow delete: if false;
      
      match /chats/{chatId} {
        allow read: if isOwner(userId) && isValidId(chatId);
        allow create: if isOwner(userId) && isValidId(chatId) &&
                      isValidChat(incoming(), 'create');
        allow update: if isOwner(userId) && isValidId(chatId) &&
                      isValidChat(incoming(), 'update') &&
                      incoming().diff(existing()).affectedKeys().hasOnly(['title', 'messages', 'updatedAt']);
        allow delete: if isOwner(userId) && isValidId(chatId);
      }
    }
  }
}
