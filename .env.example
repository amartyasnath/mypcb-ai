# Copy this file to `.env` and fill in real values. `.env` is gitignored.
#
# IMPORTANT: every variable here is SERVER-SIDE ONLY. None of them are exposed to
# the browser bundle. Do not add them to `define` in vite.config.ts, and do not
# prefix them with VITE_, or they will be readable by every visitor.

# GEMINI_API_KEY (required): key for the Google Gemini API.
# Get one at https://aistudio.google.com/apikey
GEMINI_API_KEY=""

# GEMINI_MODEL (optional): overrides the model without a code change.
# Defaults to gemini-2.5-flash.
GEMINI_MODEL="gemini-2.5-flash"

# PORT (optional): the port to listen on. Most hosts (Cloud Run, Render, Fly)
# inject this automatically. Defaults to 3000.
PORT="3000"

# DISCORD_WEBHOOK_URL (optional): forwards signups and feedback submissions to a
# Discord channel. Alerts are skipped entirely if this is unset.
DISCORD_WEBHOOK_URL=""
