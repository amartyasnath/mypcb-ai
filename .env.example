# Node server only. Free sample mode is the default, even when a key exists.
DEMO_MODE="true"

# Optional, only for Node live mode (DEMO_MODE=false).
# API billing is separate from a Claude subscription.
ANTHROPIC_API_KEY=""
# Set a model supported by your account before enabling live mode.
CLAUDE_MODEL=""
MAX_WEB_SEARCHES="6"
PORT="3000"

# Optional contact delivery. Without this, the UI reports unconfigured delivery.
DISCORD_WEBHOOK_URL=""
